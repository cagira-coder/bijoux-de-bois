# Copiez ce fichier en ".env" puis remplissez les valeurs.

# Clé secrète Stripe (Dashboard Stripe > Développeurs > Clés API).
# Commencez avec une clé de TEST (sk_test_...) ; passez en sk_live_... pour encaisser de vrais paiements.
STRIPE_SECRET_KEY=

# Secret de signature du webhook (facultatif, sert à enregistrer les commandes dans data/orders.json).
STRIPE_WEBHOOK_SECRET=

# Adresse publique du site (sans / à la fin). Laissez vide : elle est alors déduite
# automatiquement de l'adresse visitée (recommandé).
BASE_URL=

# Port d'écoute du serveur
PORT=3000

# Devise des prix (code ISO en minuscules : eur, chf, usd...)
CURRENCY=eur
